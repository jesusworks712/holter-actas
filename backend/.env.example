# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env real a git ni lo compartas.

# Credenciales de PostgreSQL (deben coincidir con docker-compose.yml)
DB_USER=holter
DB_PASSWORD=    # <-- pon aquí una contraseña fuerte
DB_NAME=holter_actas

DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# Obligatoria. Mínimo 32 caracteres. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Obligatoria: escribe una contraseña fuerte. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NOMBRE=Usuario General

# --- Correo (Gmail / Google Workspace con contraseña de aplicación) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=IPS Nueva Popayán

# --- Firma desde el celular y códigos QR ---
APP_URL=http://192.168.1.50:5173

# --- Avisos automáticos ---
ALERTAS_EMAIL=
RECORDATORIO_HORAS_ANTES=6